# ─────────────────────────────────────────────────────────────────────────────
# Dev environment — переменные для локального запуска
# Используется: docker-compose.dev.yml + локальные FastAPI/Celery/Nuxt процессы
#
# Подключение: cp .env.dev .env  (или настроить в IDE/shell)
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=myapp_dev
POSTGRES_USER=myapp
POSTGRES_PASSWORD=devpassword
POSTGRES_HOST=localhost
DATABASE_URL=postgresql+asyncpg://myapp:devpassword@localhost:5432/myapp_dev

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=myapp
RABBITMQ_PASSWORD=devpassword
RABBITMQ_HOST=localhost
RABBITMQ_URL=amqp://myapp:devpassword@localhost:5672//

# ── MinIO (локальный S3) ──────────────────────────────────────────────────────
# ref: spec.md → MinIO for Dev — S3-Compatible Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=myapp-dev
S3_ADDRESSING_STYLE=path
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Email / SMTP (Mailpit в dev) ──────────────────────────────────────────────
# ref: spec.md → Mailpit SMTP: localhost:1025 (без аутентификации)
# Prod: SMTP_HOST=smtp.mailgun.org SMTP_PORT=587 SMTP_TLS=true + user/password
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=false
EMAIL_FROM=noreply@myapp-dev.local

# ── JWT & Auth ────────────────────────────────────────────────────────────────
# ref: spec.md → @nuxt/auth-utils, HTTP-only cookies, Session Management
JWT_SECRET=dev-jwt-secret-change-in-production-minimum-64-chars-xxxxxxxxxxxxx
SESSION_SECRET=dev-session-secret-xxxxx

# ── CORS / Origins ────────────────────────────────────────────────────────────
# ref: spec.md → CORS/Cookie hardening
ALLOWED_ORIGINS=["http://localhost:3000"]
CORS_ORIGIN=http://localhost:3000

# ── Nuxt ──────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_API_BASE=http://localhost:8000/api
NUXT_PUBLIC_WS_BASE=ws://localhost:8000/ws
NUXT_SESSION_DOMAIN=localhost

# ── FastAPI / Uvicorn ─────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=debug

# ── Celery ────────────────────────────────────────────────────────────────────
# ref: celeryconfig.py → CELERY_TASK_ALWAYS_EAGER для unit-тестов (не dev-сервера)
CELERY_TASK_ALWAYS_EAGER=false

# ── Sentry (опционально в dev) ────────────────────────────────────────────────
# Оставьте пустым — Sentry SDK не инициализируется при пустом DSN
SENTRY_DSN=
