# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for Docker Swarm stack (myapp)
# Copy to .env on VPS, fill in values, then create Docker secrets (see below).
#
# DO NOT commit this file with real values — only the .example template.
# ref: spec.md → Docker Secrets for all sensitive data
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
GITHUB_REPO=your-org/your-repo
IMAGE_TAG=latest

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=myapp
POSTGRES_USER=myapp
# Secret: docker secret create postgres_password - <<< "your-strong-password"

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=myapp
# Secret: docker secret create rabbitmq_password - <<< "your-strong-password"

# ── Yandex Cloud Object Storage ───────────────────────────────────────────────
# ref: Yandex Cloud → Object Storage → Бакеты → Управление доступом → Сервисные аккаунты
# Endpoint и регион захардкожены в docker-stack.yml: storage.yandexcloud.net / ru-central1
S3_BUCKET_NAME=myapp-production
# Secret: docker secret create s3_access_key - <<< "your-yc-access-key-id"
# Secret: docker secret create s3_secret_key - <<< "your-yc-secret-access-key"

# ── Mailgun ───────────────────────────────────────────────────────────────────
# ref: spec.md → Mailgun (DKIM/SPF/DMARC must be configured for mydomain.ru)
MAILGUN_DOMAIN=mg.mydomain.ru
# Secret: docker secret create mailgun_api_key - <<< "your-mailgun-api-key"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Secret: docker secret create jwt_secret - <<< "$(openssl rand -hex 64)"

# ── Traefik basic-auth (htpasswd format) ─────────────────────────────────────
# Generate: htpasswd -nB admin | docker secret create traefik_users -
# Secret: docker secret create traefik_users - <<< "admin:$$2y$$..."

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-in-production

# ─────────────────────────────────────────────────────────────────────────────
# Secret creation cheatsheet (run on VPS as root/docker user):
#
#   echo "strong-pass"  | docker secret create postgres_password -
#   echo "strong-pass"  | docker secret create rabbitmq_password -
#   echo "AKID..."      | docker secret create s3_access_key -
#   echo "SECRET..."    | docker secret create s3_secret_key -
#   echo "key-..."      | docker secret create mailgun_api_key -
#   openssl rand -hex 64 | docker secret create jwt_secret -
#   htpasswd -nB admin  | docker secret create traefik_users -
#
# Verify: docker secret ls
# ─────────────────────────────────────────────────────────────────────────────
