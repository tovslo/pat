{
  "mcpServers": {
    "postgres-mcp": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres"],
      "env": {
        "POSTGRES_CONNECTION_STRING": "postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"
      }
    },
    "rabbitmq-mcp": {
      "command": "npx",
      "args": ["-y", "rabbitmq-mcp-server"],
      "env": {
        "RABBITMQ_MANAGEMENT_URL": "http://localhost:15672",
        "RABBITMQ_USER": "${RABBITMQ_USER}",
        "RABBITMQ_PASSWORD": "${RABBITMQ_PASSWORD}"
      }
    },
    "docker-swarm-mcp": {
      "command": "npx",
      "args": ["-y", "mcp-server-docker"],
      "env": {
        "DOCKER_HOST": "unix:///var/run/docker.sock"
      }
    },
    "github-mcp": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "local-rag-mcp": {
      "command": "npx",
      "args": ["-y", "local-rag-mcp-server", "--config", "./rag-index-config.yaml"],
      "env": {
        "RAG_INDEX_PATH": "./.rag-index",
        "EMBEDDING_MODEL": "text-embedding-3-small",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}"
      }
    }
  }
}
